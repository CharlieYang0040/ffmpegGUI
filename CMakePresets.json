{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 - Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-msvc",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "FFGUI_BUILD_DESKTOP": "ON",
        "FFGUI_ENABLE_GES": "ON",
        "CMAKE_PREFIX_PATH": "${sourceDir}/.tools/Qt/6.10.2/msvc2022_64",
        "PKG_CONFIG_EXECUTABLE": "${sourceDir}/.tools/gstreamer/bin/pkg-config.exe"
      },
      "environment": {
        "PATH": "${sourceDir}/.tools/gstreamer/bin;$penv{PATH}",
        "PKG_CONFIG_PATH": "${sourceDir}/.tools/gstreamer/lib/pkgconfig"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
